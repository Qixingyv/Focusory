flowchart LR
    subgraph U[用户]
        U1[创建或编辑任务]
        U2[完成 删除或放弃]
        U3[修正后重新提交]
    end
    subgraph F[macOS 前端]
        F1[采集表单<br/>已有会话时禁用开始日]
        F2{确认危险操作?}
        F3[关闭并保留原数据]
        F4[提示错误并保留输入]
        F5[刷新本地列表与计数]
        F6[重新提交原操作]
    end
    subgraph A[Application 与 Domain]
        A1{命令校验通过?}
        A2[执行命令<br/>生成待同步变更]
    end
    subgraph L[本地存储]
        L1{原子提交成功?}
        L2[整体回滚]
    end
    subgraph B[P1 Python 后端]
        B1[本图不直接调用<br/>后续同步由 F06 负责]
    end

    U1 --> F1
    F1 -- 保存 --> A1
    F1 -- 取消 --> F3
    U2 --> F2
    F2 -- PASS --> A1
    F2 -- NG --> F3
    A1 -- PASS --> A2 --> L1
    A1 -- NG --> F4
    L1 -- PASS --> F5
    L1 -- NG --> L2 --> F4
    U3 --> F6 --> A1
