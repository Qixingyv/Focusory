flowchart LR
    subgraph U[用户]
        U1[点击任务的开始专注]
    end
    subgraph F[macOS 前端]
        F1[提交所选任务]
        F2[留在任务页<br/>提示暂不可用]
        F3[进入专注页<br/>展示运行中的倒计时]
    end
    subgraph A[Application 与 Domain]
        A1{任务可用且<br/>无活跃计时?}
        A2[交付任务与本轮配置]
    end
    subgraph T[F02 专注计时]
        T1{实际启动成功?}
    end
    subgraph B[P1 Python 后端]
        B1[不参与本机启动<br/>网络不是前置条件]
    end

    U1 --> F1 --> A1
    A1 -- PASS --> A2 --> T1
    A1 -- NG --> F2
    T1 -- PASS --> F3
    T1 -- NG --> F2
