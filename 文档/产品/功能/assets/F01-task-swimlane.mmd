flowchart LR
    subgraph U[用户]
        U1[进入任务页<br/>或切换状态]
        U2[重试本地查询]
        U3[重试同步]
    end
    subgraph F[macOS 前端]
        F1[确定当前账户<br/>与所选状态]
        F2[展示本地读取错误]
        F3[展示列表或空态<br/>未准备完成则展示同步反馈]
        F4[转交同步重试请求]
    end
    subgraph A[Application]
        A1[查询同账户任务<br/>与三状态计数]
    end
    subgraph L[本地存储]
        L1{读取成功?}
    end
    subgraph X[F06 协作边界]
        X1[提供数据准备与同步状态<br/>数据更新后通知重查]
        X2[接收同步重试请求]
    end
    subgraph B[P1 Python 后端]
        B1[本图不直接调用<br/>同步内部步骤见 F06]
    end

    U1 --> F1 --> A1 --> L1
    L1 -- PASS --> F3
    L1 -- NG --> F2
    U2 --> F1
    X1 -. 状态 .-> F3
    X1 -. 数据更新 .-> A1
    U3 --> F4 --> X2
