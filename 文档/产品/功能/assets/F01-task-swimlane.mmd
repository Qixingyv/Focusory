flowchart LR
    subgraph U[用户]
        U1[进入任务页或切换状态]
        U2[创建 编辑 开始专注或发起生命周期操作]
        U3[查看本地结果]
        U4[修正 取消或重试]
    end

    subgraph F[macOS 前端]
        F1[读取当前账户与筛选]
        F2[展示加载 列表 空态或错误]
        F3[采集表单或确认]
        F4[展示字段或业务错误]
        F5[刷新列表 数量和同步状态]
    end

    subgraph A[Application 与 Domain]
        A1[按账户和状态查询]
        A2{校验所有权 配置 生命周期与计时锁定}
        A3[执行命令并生成同步变更]
        A4[把可用任务交给 F02]
    end

    subgraph L[本地存储与同步]
        L1[按 ownerId 查询]
        L2{原子提交成功?}
        L3[回滚]
        L4[后台上传队列]
        L5[确认后移除或失败后保留]
    end

    subgraph B[P1 Python 后端]
        B1{验证登录态 所有权与幂等键}
        B2[提交当前账户业务事务]
        B3[返回确认或稳定错误]
    end

    U1 --> F1 --> A1 --> L1 --> F2 --> U3
    U2 --> F3 --> A2
    A2 -- NG --> F4 --> U4
    A2 -- 开始专注 --> A4 --> F5 --> U3
    A2 -- PASS --> A3 --> L2
    L2 -- NG --> L3 --> F4
    L2 -- PASS --> F5 --> U3
    L2 -- 待同步 --> L4 --> B1
    B1 -- PASS --> B2 --> B3 --> L5
    B1 -- NG --> B3 --> L5
    L4 -- 网络或服务失败 --> L5 --> F5
    U4 --> F3
